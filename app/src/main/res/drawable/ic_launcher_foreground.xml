<?xml version="1.0" encoding="utf-8"?>
<!-- Modern smart-home foreground: solid house glyph + wifi signal + spark accent.
     Sized for the standard 108dp adaptive-icon canvas; content is kept inside the
     66dp "safe zone" so it isn't clipped on circle / squircle / rounded-square masks. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- House silhouette (filled, rounded base) -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,25 L85,51 L85,78 C85,81.31 82.31,84 79,84 L29,84 C25.69,84 23,81.31 23,78 L23,51 Z" />

    <!-- Wifi signal, radiating upward from a dot -->
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB300"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M40,58 A19.8,19.8 0 0 1 68,58" />
    <path
        android:fillColor="#00000000"
        android:strokeColor="#FFB300"
        android:strokeWidth="5"
        android:strokeLineCap="round"
        android:pathData="M46.5,66 A11,11 0 0 1 61.5,66" />
    <path
        android:fillColor="#FFB300"
        android:pathData="M54,71.2m-3.6,0a3.6,3.6 0,1 1,7.2 0a3.6,3.6 0,1 1,-7.2 0" />

    <!-- Spark accent -->
    <path
        android:fillColor="#FFB300"
        android:strokeLineJoin="round"
        android:pathData="M75,30 L76.6,26 L78.2,30 L82,31.6 L78.2,33.2 L76.6,37 L75,33.2 L71.2,31.6 Z" />

</vector>
